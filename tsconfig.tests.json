{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/core/**/*.ts",
    "src/runtime/**/*.ts",
    "src/operator/**/*.ts",
    "src/evolution/policy.ts",
    "src/evolution/types.ts",
    "tests/**/*.ts"
  ]
}
